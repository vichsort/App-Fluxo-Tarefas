# Copie para .env (que fica fora do Git) e preencha. Nunca cole o token em chat, issue ou commit.

# Liga a ponte do atendimento com o GitHub. Sem esta linha, os tickets ficam só no app e ninguém responde.
AGENT_RUNTIME=github-actions

# true = só registra no log o que faria (não chama o GitHub). false = cria a issue e dispara o workflow de verdade.
AGENT_DRY_RUN=true

# Repositório no formato dono/nome.
GITHUB_REPO=vichsort/App-Fluxo-Tarefas

# Token fine-grained (gratuito) só deste repositório, com Issues e Actions em leitura e escrita.
GITHUB_ISSUES_TOKEN=
